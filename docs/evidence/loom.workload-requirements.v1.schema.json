{
  "$defs": {
    "Allowlist": {
      "additionalProperties": false,
      "properties": {
        "cidrs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cidrs",
          "type": "array"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        },
        "kind": {
          "const": "allowlist",
          "default": "allowlist",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "domains"
      ],
      "title": "Allowlist",
      "type": "object"
    },
    "ExecutionPrerequisiteV1": {
      "additionalProperties": false,
      "description": "An unresolved dependency, with an optional opaque inventory reference.",
      "properties": {
        "kind": {
          "enum": [
            "endpoint",
            "managed_secret",
            "device",
            "fixture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Name",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^(?:loom|k8s-secret)://[A-Za-z0-9._/@:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "ExecutionPrerequisiteV1",
      "type": "object"
    },
    "GatewayOnly": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gateway-only",
          "default": "gateway-only",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "GatewayOnly",
      "type": "object"
    },
    "ImageMaterialization": {
      "enum": [
        "immutable_oci",
        "task_dockerfile",
        "mutable_oci",
        "unspecified"
      ],
      "title": "ImageMaterialization",
      "type": "string"
    },
    "IsolationLevel": {
      "description": "Container isolation supplied by an execution class.",
      "enum": [
        "shared_kernel",
        "sandboxed_runtime",
        "dedicated_ephemeral_node",
        "dedicated_guest_kernel"
      ],
      "title": "IsolationLevel",
      "type": "string"
    },
    "NetworkAccess": {
      "enum": [
        "none",
        "gateway_only",
        "approved_allowlist",
        "unrestricted_public"
      ],
      "title": "NetworkAccess",
      "type": "string"
    },
    "NoNetwork": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "no-network",
          "default": "no-network",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "NoNetwork",
      "type": "object"
    },
    "Public": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "public",
          "default": "public",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Public",
      "type": "object"
    },
    "PublicWeb": {
      "additionalProperties": false,
      "description": "Public HTTP and HTTPS through the gateway dialer.\n\nThis is not Docker ``Public``. The execution pod still has no route to\nthe public internet; the gateway dials port 80 or 443 after the public\naddress checks.",
      "properties": {
        "kind": {
          "const": "public-web",
          "default": "public-web",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "PublicWeb",
      "type": "object"
    },
    "TaskExecutionRequirementsV1": {
      "additionalProperties": false,
      "description": "Bounded capability and prerequisite declarations retained at admission.",
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "enum": [
              "nested_docker",
              "singularity_mounts",
              "isolated_kernel_settings",
              "external_cluster",
              "pkcs11_authentication",
              "dpdk_networking",
              "emulated_pkcs11_authentication"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "title": "Capabilities",
          "type": "array"
        },
        "prerequisites": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExecutionPrerequisiteV1"
          },
          "maxItems": 32,
          "title": "Prerequisites",
          "type": "array"
        }
      },
      "title": "TaskExecutionRequirementsV1",
      "type": "object"
    },
    "VerifierTopology": {
      "enum": [
        "in_attempt",
        "separate_execution"
      ],
      "title": "VerifierTopology",
      "type": "string"
    },
    "WebAllowlist": {
      "additionalProperties": false,
      "properties": {
        "destinations": {
          "items": {
            "$ref": "#/$defs/WebDestination"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Destinations",
          "type": "array"
        },
        "kind": {
          "const": "web-allowlist",
          "default": "web-allowlist",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "destinations"
      ],
      "title": "WebAllowlist",
      "type": "object"
    },
    "WebDestination": {
      "additionalProperties": false,
      "description": "Exact public DNS destination; HTTPS uses CONNECT, HTTP uses forwarding.",
      "properties": {
        "host": {
          "maxLength": 253,
          "minLength": 3,
          "title": "Host",
          "type": "string"
        },
        "protocol": {
          "enum": [
            "http",
            "https"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "host",
        "protocol"
      ],
      "title": "WebDestination",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete material capability declaration for one execution unit.",
  "properties": {
    "cpu_architecture": {
      "enum": [
        "x86_64",
        "arm64",
        "any"
      ],
      "title": "Cpu Architecture",
      "type": "string"
    },
    "cpu_millis": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cpu Millis"
    },
    "custom_dns": {
      "title": "Custom Dns",
      "type": "boolean"
    },
    "data_residency": {
      "anyOf": [
        {
          "pattern": "^[a-z]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Residency"
    },
    "effective_network_policy": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "allowlist": "#/$defs/Allowlist",
              "gateway-only": "#/$defs/GatewayOnly",
              "no-network": "#/$defs/NoNetwork",
              "public": "#/$defs/Public",
              "public-web": "#/$defs/PublicWeb",
              "web-allowlist": "#/$defs/WebAllowlist"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Public"
            },
            {
              "$ref": "#/$defs/NoNetwork"
            },
            {
              "$ref": "#/$defs/GatewayOnly"
            },
            {
              "$ref": "#/$defs/Allowlist"
            },
            {
              "$ref": "#/$defs/WebAllowlist"
            },
            {
              "$ref": "#/$defs/PublicWeb"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective Network Policy"
    },
    "ephemeral_storage_mib": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ephemeral Storage Mib"
    },
    "execution_requirements": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskExecutionRequirementsV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extra_hosts": {
      "title": "Extra Hosts",
      "type": "boolean"
    },
    "gpu_count": {
      "minimum": 0,
      "title": "Gpu Count",
      "type": "integer"
    },
    "gpu_vendor": {
      "enum": [
        "none",
        "nvidia"
      ],
      "title": "Gpu Vendor",
      "type": "string"
    },
    "host_devices": {
      "title": "Host Devices",
      "type": "boolean"
    },
    "host_network": {
      "title": "Host Network",
      "type": "boolean"
    },
    "host_path": {
      "title": "Host Path",
      "type": "boolean"
    },
    "host_specialized": {
      "title": "Host Specialized",
      "type": "boolean"
    },
    "image_materialization": {
      "$ref": "#/$defs/ImageMaterialization"
    },
    "image_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Image Ref"
    },
    "isolation_level": {
      "$ref": "#/$defs/IsolationLevel"
    },
    "memory_mib": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Memory Mib"
    },
    "nested_containers": {
      "title": "Nested Containers",
      "type": "boolean"
    },
    "network_access": {
      "$ref": "#/$defs/NetworkAccess"
    },
    "operating_system": {
      "enum": [
        "linux",
        "windows"
      ],
      "title": "Operating System",
      "type": "string"
    },
    "privileged": {
      "title": "Privileged",
      "type": "boolean"
    },
    "schema_version": {
      "const": "loom.workload-requirements.v1",
      "default": "loom.workload-requirements.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sidecar_count": {
      "minimum": 0,
      "title": "Sidecar Count",
      "type": "integer"
    },
    "task_egress": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "public-web": "#/$defs/PublicWeb",
              "web-allowlist": "#/$defs/WebAllowlist"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WebAllowlist"
            },
            {
              "$ref": "#/$defs/PublicWeb"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Egress"
    },
    "tmpfs": {
      "title": "Tmpfs",
      "type": "boolean"
    },
    "verifier_topology": {
      "$ref": "#/$defs/VerifierTopology"
    }
  },
  "required": [
    "operating_system",
    "cpu_architecture",
    "gpu_vendor",
    "gpu_count",
    "cpu_millis",
    "memory_mib",
    "ephemeral_storage_mib",
    "isolation_level",
    "network_access",
    "image_materialization",
    "image_ref",
    "sidecar_count",
    "verifier_topology",
    "custom_dns",
    "extra_hosts",
    "tmpfs",
    "privileged",
    "host_path",
    "host_network",
    "nested_containers",
    "host_devices",
    "host_specialized"
  ],
  "title": "WorkloadRequirementsV1",
  "type": "object"
}
