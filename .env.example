# Loom dev-stack environment overrides.
#
# Copy to `.env` at the repo root; `deploy/docker-compose.dev.yml`
# picks it up automatically. `loom service up` reads it for the
# bootstrap sequence.
#
# `.env` is gitignored — secrets stay local.

# --- LLM provider keys ---------------------------------------------
# Optional gateway-resident keys for legacy local requests. Normal service
# runs use team-owned provider connections instead. Compose retains dummy
# OpenAI/Anthropic defaults when blank; Google defaults to an empty key.
# The `oracle` agent does not need a provider key.
LOOM_GW_ANTHROPIC_API_KEY=
LOOM_GW_OPENAI_API_KEY=
LOOM_GW_GOOGLE_API_KEY=

# --- Dev step-JWT signing contract --------------------------------
# Single local source for the Control Plane, LLM Gateway, and a manually
# started family orchestrator. The dev compose file maps this value into both
# CP and Gateway settings; `python -m loom_family_orchestrator` reads the same
# LOOM_CP_* variable directly. Development only: use a secret reference in
# protected deployments, never this checked-in value.
LOOM_CP_STEP_JWT_SIGNING_KEY=dev-only-shared-jwt-key-do-not-use-in-prod

# --- Hugging Face catalog mirror token -----------------------------
# Optional read token for host-side gated benchmark provisioning during
# `loom service up`. Worker containers do not receive HF_TOKEN; staging/prod
# workers materialize from internal object-store mirrors.
HF_TOKEN=

# --- Worker token --------------------------------------------------
# Bearer the Worker uses to call CP /trials/claim + PATCH /state.
# `loom service up` mints + populates this on first run; keep
# `placeholder` here so the Worker container starts before bootstrap.
LOOM_WORKER_TOKEN=placeholder

# Least-privilege token for the local `task-image-builder` sidecar
# (`task-image:build` only). `loom service up` mints + populates this.
# Trial workers must not use this token.
LOOM_TASK_IMAGE_BUILDER_TOKEN=placeholder

# Optional worker tuning. Leave the blocking-I/O executor unset for normal dev;
# it derives from max concurrency as max(32, min(max_concurrent * 4, 256)).
# LOOM_WORKER_MAX_CONCURRENT=5
# LOOM_WORKER_BLOCKING_IO_MAX_WORKERS=32
# Per-task Dockerfile build context guardrails for service-mode workers.
# Leave defaults unless capacity tests show a larger authored benchmark bundle
# is expected and safe for the host.
# LOOM_TASK_IMAGE_BUILD_MAX_FILES=2000
# LOOM_TASK_IMAGE_BUILD_MAX_BYTES=536870912

# --- Singleton admin secret ---------------------------------------
# Admin credentials are file-backed singleton secrets, not DB tokens.
# `loom service up` creates `.loom/admin/secrets.toml` for local dev and the
# dev compose stack mounts it into all admin-aware services. Production
# manifests set LOOM_ENV=production and point each service at the same mounted
# `secrets.toml` file with mode 0600 or stricter.
# LOOM_SVC_ADMIN_SECRET_FILE=/var/run/loom/secrets/admin/secrets.toml
# LOOM_CP_ADMIN_SECRET_FILE=/var/run/loom/secrets/admin/secrets.toml
# LOOM_GW_ADMIN_SECRET_FILE=/var/run/loom/secrets/admin/secrets.toml

# --- Team registration gate ---------------------------------------
# Default-closed onboarding path: POST /api/v1/teams/register creates a
# pending request for admin approval. Keep false until the open-registration
# captcha / rate-limit / email challenge hook ships; true currently returns 501.
LOOM_SVC_TEAM_REGISTRATION_OPEN=false

# --- Browser user sessions ---------------------------------------
# The SPA signs in through /api/v1/auth/* and stores only an HttpOnly
# session cookie. Auth responses return a CSRF token that the SPA keeps in
# memory and echoes through X-Loom-CSRF on unsafe session requests. Local
# Compose uses the loom_session cookie over HTTP; hosted sessions use Secure
# __Host-loom_session cookies. The bundled web/CLI clients require these names.
LOOM_SVC_AUTH_SESSION_TTL_SEC=604800
LOOM_SVC_AUTH_LOGIN_CHALLENGE_TTL_SEC=900
# Local development/tests only: return a raw one-time login token from
# /api/v1/auth/login/start instead of relying on email delivery.
LOOM_SVC_AUTH_RETURN_LOGIN_TOKEN=false

# --- Optional: QA matrix relay (`loom qa matrix`) ------------------
# Operator-side end-to-end agent × benchmark validation against a
# real provider. The relay is registered as a Loom provider connection
# after `loom service up` runs:
#
#   loom providers create \
#     --type openai-compatible \
#     --base-url "$LOOM_QA_RELAY_BASE_URL" \
#     --api-key env:LOOM_QA_RELAY_API_KEY \
#     --name qa-relay \
#     --rate-card-provider openai
#
# Then submit a matrix run:
#
#   loom qa matrix --provider-connection qa-relay --model gpt-4o-mini
#
# Treat the API key like any production secret — gitignored in `.env`,
# rotate if it ever lands in chat / logs / a screenshot.
LOOM_QA_RELAY_BASE_URL=
LOOM_QA_RELAY_API_KEY=

# --- Optional: local benchmark import ------------------------------
# `loom service up` uses public HF benchmark bundles by default. Set
# LOOM_LOCAL_IMPORT=1 only when you need the slower local MinIO import path.
# The matching local-only MinIO credentials live in deploy/docker-compose.dev.yml.
# LOOM_LOCAL_IMPORT=1
# LOOM_MINIO_ENDPOINT=http://localhost:9000
# LOOM_MINIO_ACCESS_KEY=
# LOOM_MINIO_SECRET_KEY=

# Downloads are proxied through loom-service. The dev stack uses its internal
# MinIO endpoint and does not require a public MinIO URL for browser/CLI downloads.
