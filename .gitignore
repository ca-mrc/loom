# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Node
/web/coverage/
node_modules/
dist/
build/
.vite/

# Local env and secrets
.env
.env.*
!.env.example
..env.*.tmp
gb10-node-agent.env
*.local
.env.local

# Developer-specific local dev cluster config (copied from
# deploy/local/local.example.cluster.toml). The example template stays tracked.
/deploy/local/local.cluster.toml

# Owner-local Codex context
AGENTS.md
MEMORY.md

# Runtime artifacts
.runtime/
.loom/
data/
!src/loom_cli/data/
/artifacts/
outputs/
logs/
# CLI-mode default per-trial output: `loom run --output-dir` defaults
# to `./runs`, and its `_tasks/` scratch subdirectory can hold
# hundreds of MB per trial. Anchored at the repo root so a
# `docs/architecture/foo/runs` path (unlikely but possible) still
# tracks normally.
/runs/

# IDE
.idea/
.vscode/
NEW_SESSION_BRIEFING.md

# Claude Code workspace — session state + worktrees. The worktrees
# directory alone is ~hundreds of MB of repo clones, which floods
# the IDE source-control panel with phantom "untracked" entries.
.claude/

# Agent planning plugins may default to this path. Loom keeps durable designs
# under docs/architecture/; execution plans belong outside the repository.
/docs/superpowers/
/docs/plans/
/plans/
.superpowers/
implementation-plans/
implementation_plans/

# Codex feature worktrees.
.worktrees/

# Go build artifacts at repo root from `go build ./...` runs
/loom-llm-gateway-sandbox

# Operator-owned storage lifecycle config. `config/storage-lifecycle.example.toml`
# is the committed template; operators `cp` it to `config/storage-lifecycle.toml`
# and tune per-workload retention windows before running
# `loom cluster bootstrap-storage-lifecycle` (see docs/runbooks/operator-runbook.md).
# The active copy is per-deployment and must not be committed.
config/storage-lifecycle.toml
