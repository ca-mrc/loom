apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: loom-ingress
  annotations:
    # Adjust to match your cluster's ingress controller (nginx, traefik,
    # gke-ingress, alb, etc.). Defaults assume nginx.
    # TaskSet bundles are uploaded through this ingress. 2g covers a full
    # Terminal-Bench 4.0.0 archive (~431MB gzipped). The service quota stays 5 GiB.
    nginx.ingress.kubernetes.io/proxy-body-size: "2g"
{% if frontend_prefixed_route %}
    nginx.ingress.kubernetes.io/use-regex: "true"
    nginx.ingress.kubernetes.io/rewrite-target: /$1
{% endif %}
{% if ingress_redirect_hosts %}
    nginx.ingress.kubernetes.io/from-to-www-redirect: "true"
{% endif %}
{% if ingress_cert_manager_cluster_issuer %}
    cert-manager.io/cluster-issuer: {{ ingress_cert_manager_cluster_issuer }}
{% endif %}
spec:
  ingressClassName: {{ ingress_class_name }}
  tls:
{% if ingress_host_is_ip %}
    # Kubernetes forbids IP literals in Ingress host fields. For
    # IP-address entrypoints, pre-create this Secret with an IP SAN
    # certificate; the hostless rule below matches the IP Host header.
    - secretName: {{ ingress_tls_secret_name }}
{% else %}
    - hosts:
        - {{ ingress_host }}
{% for host in ingress_redirect_hosts %}
        - {{ host }}
{% endfor %}
      secretName: {{ ingress_tls_secret_name }}
{% endif %}
  rules:
    # On `{{ ingress_host }}`{% if frontend_route_path %} under `{{ frontend_route_path }}`{% endif %}:
{% if frontend_prefixed_route %}
    #   {{ frontend_route_path }}/api/v1[/segments]  → loom_service (rewritten to /api/v1[/segments])
    #   {{ frontend_route_path }}/[/segments]        → loom_web (rewritten before nginx fallback)
    #   {{ frontend_route_path }}           → loom_web unchanged for canonical redirect
{% else %}
    #   /api/v1/*  → loom_service (REST surface mounted at /api/v1/*)
    #   anything else → loom_web (React SPA; nginx falls back to
    #                   index.html for client-side React Router paths)
{% endif %}
    #
{% if frontend_prefixed_route %}
    # ingress-nginx sorts regex locations by raw path length before applying
    # first-regex-match semantics. The API regex is intentionally longer than
    # the overlapping SPA regex; YAML declaration order does not set precedence.
{% else %}
    # Prefix paths are evaluated longest-first, so `/api/v1` wins over `/`.
{% endif %}
{% if ingress_host_is_ip %}
    - http:
{% else %}
    - host: {{ ingress_host }}
      http:
{% endif %}
        paths:
{% if frontend_prefixed_route %}
          - path: /(?-i:{{ frontend_route_path[1:] }})/(api/v1((/[^/%]+)*/?))$
            pathType: ImplementationSpecific
            backend:
              service:
                name: loom-service
                port:
                  number: 8090
          - path: /(?-i:{{ frontend_route_path[1:] }})/(([^/%]+/)*[^/%]+/?)?$
            pathType: ImplementationSpecific
            backend:
              service:
                name: loom-web
                port:
                  number: 80
{% else %}
          - path: /api/v1
            pathType: Prefix
            backend:
              service:
                name: loom-service
                port:
                  number: 8090
          - path: /
            pathType: Prefix
            backend:
              service:
                name: loom-web
                port:
                  number: 80
{% endif %}
  # NOTE: the Control Plane (`loom-control-plane:8080`) is intentionally
  # NOT exposed via Ingress. It carries worker-only routes
  # (`POST /trials/claim`, `PATCH /trials/{id}/state`) and admin
  # endpoints (`POST /admin/worker-tokens`) that should only be
  # reachable from inside the cluster. Workers + `loom_service`
  # reach the CP through cluster DNS (`http://loom-control-plane:8080`).
  # For operator-side admin curls, port-forward:
  #   kubectl port-forward deploy/loom-control-plane 8080:8080
  #
  # The LLM Gateway is also intentionally NOT exposed via public
  # Ingress. Sandboxes reach it through the internal gateway-router /
  # singleton path; public browser and CLI traffic goes through
  # `loom-service` under `/api/v1`.
{% if frontend_prefixed_route %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: loom-frontend-prefix-redirect
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "2g"
    nginx.ingress.kubernetes.io/use-regex: "true"
spec:
  ingressClassName: {{ ingress_class_name }}
  tls:
{% if ingress_host_is_ip %}
    - secretName: {{ ingress_tls_secret_name }}
{% else %}
    - hosts:
        - {{ ingress_host }}
{% for host in ingress_redirect_hosts %}
        - {{ host }}
{% endfor %}
      secretName: {{ ingress_tls_secret_name }}
{% endif %}
  rules:
{% if ingress_host_is_ip %}
    - http:
{% else %}
    - host: {{ ingress_host }}
      http:
{% endif %}
        paths:
          - path: /(?-i:{{ frontend_route_path[1:] }})$
            pathType: ImplementationSpecific
            backend:
              service:
                name: loom-web
                port:
                  number: 80
{% endif %}
