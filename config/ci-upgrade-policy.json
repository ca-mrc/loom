{
  "schema_version": 1,
  "max_actions_per_batch": 2,
  "node24_minimum_runner": "2.327.1",
  "required_canary_contexts": [
    "repository-checks",
    "images-gate",
    "cluster-smoke-gate",
    "staging-smoke-gate"
  ],
  "batches": [
    {
      "name": "artifact-io",
      "actions": ["actions/upload-artifact", "actions/download-artifact"],
      "compatibility_tests": [
        "uv run --no-sync pytest -q tests/ops/test_ci_action_pins.py tests/ops/test_ci_upgrade_policy.py",
        "actionlint .github/workflows/*.yml"
      ],
      "rollback": {
        "actions/upload-artifact": {
          "sha": "ea165f8d65b6e75b540449e92b4886f43607fa02",
          "version": "v4"
        },
        "actions/download-artifact": {
          "sha": "d3f86a106a0bac45b974a628896c90dbdf5c8093",
          "version": "v4"
        }
      }
    },
    {
      "name": "checkout",
      "actions": ["actions/checkout"],
      "compatibility_tests": ["actionlint .github/workflows/*.yml"],
      "rollback": {
        "actions/checkout": {
          "sha": "93cb6efe18208431cddfb8368fd83d5badbf9bfd",
          "version": "v5"
        }
      }
    },
    {
      "name": "language-bootstrap",
      "actions": ["actions/setup-go", "actions/setup-node"],
      "compatibility_tests": [
        "uv run --no-sync pytest -q tests/ops/test_ci_action_pins.py tests/ops/test_ci_upgrade_policy.py",
        "actionlint .github/workflows/ci.yml",
        "test -z \"$(gofmt -l ./cmd/)\"",
        "go vet ./cmd/...",
        "go test -race ./cmd/..."
      ],
      "rollback": {
        "actions/setup-go": {
          "sha": "40f1582b2485089dde7abd97c1529aa768e1baff",
          "version": "v5"
        },
        "actions/setup-node": {
          "sha": "249970729cb0ef3589644e2896645e5dc5ba9c38",
          "version": "v6"
        }
      }
    },
    {
      "name": "python-bootstrap",
      "actions": ["astral-sh/setup-uv"],
      "compatibility_tests": [
        "uv run --no-sync pytest -q tests/ops/test_ci_upgrade_policy.py",
        "actionlint .github/workflows/*.yml"
      ],
      "rollback": {
        "astral-sh/setup-uv": {
          "sha": "fac544c07dec837d0ccb6301d7b5580bf5edae39",
          "version": "v8.2.0"
        }
      }
    },
    {
      "name": "fixture-cache",
      "actions": [
        "actions/cache"
      ],
      "compatibility_tests": [
        "uv run --no-sync pytest -q tests/unit/test_minio_image_preparation.py tests/ops/test_ci_secret_isolation.py",
        "actionlint .github/workflows/ci.yml"
      ],
      "rollback": {
        "actions/cache": {
          "sha": "0057852bfaa89a56745cba8c7296529d2fc39830",
          "version": "v4.3.0"
        }
      }
    }
  ]
}
