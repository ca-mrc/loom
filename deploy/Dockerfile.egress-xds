# loom_egress_xds — Envoy egress-proxy control plane.
#
# Standalone Python image. Envoy/gRPC dependencies are isolated from the
# application install; google-genai no longer imposes the legacy protobuf cap.

FROM python:3.11-slim
RUN apt-get update -qq && \
    apt-get install -y --only-upgrade --no-install-recommends perl-base=5.40.1-6+deb13u1 && \
    rm -rf /var/lib/apt/lists/*

# Retry transient package-index timeouts during image builds.
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60

WORKDIR /app

# Runtime dependencies are pinned for Envoy v1.30. Version specifiers must be
# quoted — unquoted `<3.0`
# is interpreted by /bin/sh as input redirection and the build
# fails with "cannot open 3.0: No such file".
RUN pip install --no-cache-dir \
        "envoy-data-plane==2.1.0" \
        "xds-protos==1.81.1" \
        "grpcio>=1.81,<2.0" \
        "psycopg[binary]>=3.2,<4.0" \
        "prometheus-client>=0.19,<1.0"

# Copy the package into /app and add /app to PYTHONPATH so
# `python -m loom_egress_xds` resolves the package without a
# `pip install -e .` step (which would require copying pyproject +
# the whole src/ tree just for setuptools metadata).
# The provider-connections watcher imports loom_listen for LISTEN/NOTIFY
# metrics and the startup self-test; that package must live on PYTHONPATH.
COPY src/loom_egress_xds /app/loom_egress_xds
COPY src/loom_listen /app/loom_listen

EXPOSE 18000

# Defaults match the bootstrap (deploy/envoy/egress-proxy.yaml) +
# loom-egress-xds k8s Service. Override LOOM_EGRESS_XDS_DB_URL via
# Secret; the rest are usually fine as-is.
ENV LOOM_EGRESS_XDS_LISTEN_ADDR=0.0.0.0:18000 \
    LOOM_EGRESS_XDS_LOG_LEVEL=INFO \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

ENTRYPOINT ["python", "-m", "loom_egress_xds"]
