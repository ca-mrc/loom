FROM python:3.12-slim
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60 \
    LITELLM_LOCAL_MODEL_COST_MAP=True
# Keep the existing Harbor compatibility version and current-user tool probes.
ARG HARBOR_COMPAT_SHA=09f5b964f8e5075f7e52fd08c9994dfc80ad5d24
ARG HARBOR_VERSION=0.24.0
WORKDIR /app
COPY deploy/harbor-runtime-requirements.txt /tmp/harbor-runtime-requirements.txt
COPY scripts/ops/prepare_harbor_model_cost_map.py /tmp/prepare_harbor_model_cost_map.py
COPY deploy/patches/harbor-current-user-tool-probes.patch /tmp/harbor-current-user-tool-probes.patch
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends perl-base=5.40.1-6+deb13u1 git patch && \
    pip install --no-cache-dir --requirement /tmp/harbor-runtime-requirements.txt \
      "harbor @ git+https://github.com/harbor-framework/harbor.git@${HARBOR_COMPAT_SHA}" && \
    python -I -B /tmp/prepare_harbor_model_cost_map.py && \
    patch --batch --forward -p1 -d "$(python -I -c 'import harbor; print(next(iter(harbor.__path__)))')" < /tmp/harbor-current-user-tool-probes.patch && \
    rm /tmp/harbor-runtime-requirements.txt /tmp/harbor-current-user-tool-probes.patch /tmp/prepare_harbor_model_cost_map.py && \
    apt-get purge -y --auto-remove git patch && \
    rm -rf /var/lib/apt/lists/* && \
    pip check && \
    python -I -c "import importlib.metadata; assert importlib.metadata.version('harbor') == '${HARBOR_VERSION}'"
ARG LOOM_BRIDGE_REVISION=1.0
ARG LOOM_AGENT_VERSION=development
ARG LOOM_BUILD_SHA=development
ENV LOOM_HARBOR_SOURCE_REVISION=${HARBOR_COMPAT_SHA} \
    LOOM_BRIDGE_REVISION=${LOOM_BRIDGE_REVISION} \
    LOOM_AGENT_VERSION=${LOOM_AGENT_VERSION}
LABEL org.opencontainers.image.revision=${LOOM_BUILD_SHA} \
    io.loom.agent_name=terminus-2 \
    io.loom.agent_version=${LOOM_AGENT_VERSION} \
    io.loom.runtime_contract=loom.terminus-controller.v1 \
    io.loom.harbor_version=${HARBOR_VERSION} \
    io.loom.harbor_source_revision=${HARBOR_COMPAT_SHA} \
    io.loom.loom_bridge_revision=${LOOM_BRIDGE_REVISION}
# Install the whole Loom library at a trusted Python location. Isolated Python
# ignores PYTHONPATH; no editable install, worker package or per-file copy list.
COPY src/loom /usr/local/lib/python3.12/site-packages/loom
# Installed-harness adapters (Codex, #2311): pure Python, pydantic only.
COPY packages/loom-launcher/loom_launcher /usr/local/lib/python3.12/site-packages/loom_launcher
USER 65532:65532
RUN --network=none python -I -B -c "import litellm; assert litellm.model_cost; import loom.service_execution_sandbox_task; import loom_launcher.adapters.codex; from loom.agent.terminus2.runtime import _import_terminus2; _import_terminus2(); from harbor.agents.terminus_2.tmux_session import TmuxSession"
CMD ["python", "-I", "-B", "-m", "loom.service_execution_sandbox_task", "--help"]
