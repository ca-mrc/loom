# Multi-stage build: node builds the SPA bundle; nginx serves it.
#
# Stage 1 — build
FROM node:20-slim AS build
WORKDIR /web
ARG TARGETARCH
# #2009: reused from the release publisher's existing candidate identity
# (scripts/ops/nebius_candidate.py). Baked into the bundle via Vite `define`
# (see vite.config.ts) so the displayed version always identifies the exact
# JS actually loaded in the browser — never a value a later fetch could
# change out from under an already-open tab. Defaulted so a plain
# `docker build` (no --build-arg) still produces a working, honestly
# "unknown"-labeled local bundle.
ARG LOOM_BUILD_SHA=unknown
ARG LOOM_SOURCE_REF=unknown
ARG LOOM_BUILD_KIND=commit
ARG LOOM_SOURCE_DIGEST=unknown
ARG LOOM_SOURCE_BASE_COMMIT=unknown
COPY web/package.json web/package-lock.json ./
# Native bindings are already pinned in the lockfile. A second npm install
# with --package-lock=false upgrades unrelated dependencies after npm ci.
RUN npm ci
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) \
        rolldown_binding="@rolldown/binding-linux-x64-gnu" \
        ;; \
      arm64) \
        rolldown_binding="@rolldown/binding-linux-arm64-gnu" \
        ;; \
      *) echo "unsupported web image TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    node -e "require('lightningcss'); require('${rolldown_binding}')"
COPY web/ ./
RUN VITE_BUILD_REVISION="${LOOM_BUILD_SHA}" \
    VITE_BUILD_SOURCE_REF="${LOOM_SOURCE_REF}" \
    VITE_BUILD_KIND="${LOOM_BUILD_KIND}" \
    VITE_SOURCE_DIGEST="${LOOM_SOURCE_DIGEST}" \
    VITE_SOURCE_BASE_COMMIT="${LOOM_SOURCE_BASE_COMMIT}" \
    VITE_BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    npm run build

# Stock Caddy supplies the Nebius TLS sidecar from this same published image.
# v2.11.4's released binary has CVE-2026-56854 in x/crypto v0.52.0.
# Remove the x/crypto override when the next Caddy release includes the fix.
FROM --platform=$BUILDPLATFORM golang:1.26.8-alpine AS public-tls
WORKDIR /build
RUN go mod init caddy \
    && go mod download github.com/caddyserver/caddy/v2@v2.11.4 \
    && cp /go/pkg/mod/github.com/caddyserver/caddy/v2@v2.11.4/cmd/caddy/main.go . \
    && go get github.com/caddyserver/caddy/v2@v2.11.4 golang.org/x/crypto@v0.55.0
ARG TARGETARCH
RUN CGO_ENABLED=0 GOARCH=${TARGETARCH} go build -mod=mod -trimpath -ldflags='-s -w' -o /caddy .

# Stage 2 — serve. `nginxinc/nginx-unprivileged` is the official
# non-root nginx image: runs as uid 101 (`nginx`), listens on 8080
# (unprivileged port) by default. Avoids a root-in-container surface
# for CVEs in the nginx master process.
FROM nginxinc/nginx-unprivileged:1.27-alpine
USER root
# #2009: re-declared so the entrypoint (web-runtime-config.sh) can stamp the
# same build identity into loom-frontend-config.json — the "currently
# served build" signal an open tab polls on focus. Independent of the
# bundle-baked identity above: that one is frozen in the JS a tab already
# loaded, this one reflects whatever this container is serving right now.
ARG LOOM_BUILD_SHA=unknown
ARG LOOM_SOURCE_REF=unknown
ARG LOOM_BUILD_KIND=commit
ARG LOOM_SOURCE_DIGEST=unknown
ARG LOOM_SOURCE_BASE_COMMIT=unknown
ENV LOOM_FRONTEND_BUILD_REVISION=${LOOM_BUILD_SHA}
ENV LOOM_FRONTEND_SOURCE_REF=${LOOM_SOURCE_REF}
ENV LOOM_FRONTEND_BUILD_KIND=${LOOM_BUILD_KIND}
ENV LOOM_FRONTEND_SOURCE_DIGEST=${LOOM_SOURCE_DIGEST}
ENV LOOM_FRONTEND_SOURCE_BASE_COMMIT=${LOOM_SOURCE_BASE_COMMIT}
# ENV can't hold a computed value, so the build timestamp goes in a file
# the entrypoint reads instead (mirrors deploy/Dockerfile.service's
# /opt/loom/build-time for the backend).
RUN date -u +%Y-%m-%dT%H:%M:%SZ > /etc/loom-frontend-build-time
COPY --from=public-tls /caddy /usr/bin/caddy
COPY --from=build /web/dist /usr/share/nginx/html
COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-spa-security-headers.conf /etc/nginx/loom-spa-security-headers.conf
COPY deploy/web-runtime-config.sh /docker-entrypoint.d/40-loom-frontend-config.sh
RUN apk add --no-cache \
      "libcrypto3=3.3.7-r2" \
      "libssl3=3.3.7-r2" \
    && cp /usr/share/nginx/html/index.html /usr/share/nginx/html/index.html.template \
    && chmod 755 /docker-entrypoint.d/40-loom-frontend-config.sh \
    && chmod 644 /etc/nginx/conf.d/default.conf \
    && chmod 644 /etc/nginx/loom-spa-security-headers.conf \
    && chown -R 101:0 /usr/share/nginx/html \
    && chown root:root /usr/share/nginx/html/index.html.template \
    && chmod 444 /usr/share/nginx/html/index.html.template
USER 101
EXPOSE 8080
# nginx runs in the foreground via the base image's CMD.
