FROM golang:1.25.7-alpine@sha256:f6751d823c26342f9506c03797d2527668d095b0a15f1862cddb4d927a7a4ced AS build-deadline
WORKDIR /src
COPY go.mod ./
COPY cmd/loom-build-deadline ./cmd/loom-build-deadline
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/loom-build-deadline ./cmd/loom-build-deadline

FROM aquasec/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969 AS trivy
FROM registry.k8s.io/kubectl:v1.36.2@sha256:b0d792e0d8dfb9bb1b922b78b23137e2a34bb6f9667640353a9d2aadd1fd7761 AS kubectl
FROM docker:29.7.2-cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe AS docker-cli

FROM python:3.11-alpine3.23@sha256:c8d52af7e2645b587d464082ab29ff4ddc9fc514f353b4ed491b3ae8105d4200
# Retry each package-index request up to 10 times with a 60-second timeout so
# transient index latency does not abort the image build.
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
RUN apk add --no-cache skopeo
COPY --from=build-deadline /out/loom-build-deadline /usr/local/bin/loom-build-deadline
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
COPY --from=docker-cli /usr/local/bin/docker /usr/bin/docker
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY packages ./packages
COPY database/migrations ./database/migrations
COPY database/capacity_guard_migrations ./database/capacity_guard_migrations
COPY database/capacity_build_guard_migrations ./database/capacity_build_guard_migrations
RUN chmod -R a+rX ./src ./packages ./database/migrations ./database/capacity_guard_migrations ./database/capacity_build_guard_migrations && \
    pip install --no-cache-dir -e ./packages/loom-bundle-checksum && \
    pip install --no-cache-dir -e '.[nebius-gateway,cluster]' && \
    pip install --no-cache-dir -e ./packages/loom-launcher && \
    python -c 'from nebius.sdk import SDK; from kubernetes import client; import loom_execution_actuator.task_image_runtime'
ARG LOOM_BUILD_SHA=unknown
ARG LOOM_BUILD_KIND=commit
ARG LOOM_SOURCE_DIGEST=unknown
ARG LOOM_SOURCE_BASE_COMMIT=unknown
LABEL org.opencontainers.image.revision="${LOOM_BUILD_SHA}"
# #2009: /api/v1/version reads these two files (loom_service.build_info) to
# report this instance's own build identity without querying GitHub, k8s,
# or the database. Build time is informational only, never a trust input.
RUN install -d -m 0755 /opt/loom && \
    printf '%s\n' "${LOOM_BUILD_SHA}" > /opt/loom/build-sha && \
    printf '%s\n' "${LOOM_BUILD_KIND}" > /opt/loom/build-kind && \
    printf '%s\n' "${LOOM_SOURCE_DIGEST}" > /opt/loom/source-digest && \
    printf '%s\n' "${LOOM_SOURCE_BASE_COMMIT}" > /opt/loom/source-base-commit && \
    chmod 0444 /opt/loom/build-kind /opt/loom/source-digest /opt/loom/source-base-commit && \
    chmod 0444 /opt/loom/build-sha && \
    date -u +%Y-%m-%dT%H:%M:%SZ > /opt/loom/build-time && \
    chmod 0444 /opt/loom/build-time
EXPOSE 8090
CMD ["python", "-m", "loom_service"]
