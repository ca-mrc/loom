[Unit]
Description=Clean obsolete Loom gateway Python caches

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B %h/.local/libexec/loom/nebius_gateway_cleanup.py --config %h/.config/loom/gateway-cleanup.toml
UMask=0077
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
