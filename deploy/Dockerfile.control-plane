FROM python:3.11-slim
RUN apt-get update -qq && \
    apt-get install -y --only-upgrade --no-install-recommends perl-base=5.40.1-6+deb13u1 && \
    rm -rf /var/lib/apt/lists/*
# Retry transient package-index timeouts during image builds.
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
RUN apt-get update -qq && \
    apt-get install -y --only-upgrade --no-install-recommends perl-base && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY packages/loom-bundle-checksum ./packages/loom-bundle-checksum
COPY packages/loom-launcher ./packages/loom-launcher
COPY database/migrations ./database/migrations
COPY database/capacity_guard_migrations ./database/capacity_guard_migrations
# Trial submission validates agent names against the catalog, whose
# installed-harness entries (codex, openhands-sdk, ...) come from
# loom-launcher's adapter registry. Without it they are silently unknown.
RUN chmod -R a+rX ./src ./database/migrations ./database/capacity_guard_migrations ./packages/loom-bundle-checksum ./packages/loom-launcher && \
    pip install --no-cache-dir -e ./packages/loom-bundle-checksum && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir -e ./packages/loom-launcher && \
    python -c 'from loom.hosted_harness import NATIVE_EXECUTION_AGENT_NAMES as n; from loom_service.agent_catalog import known_names as k; missing = n - k(); assert not missing, missing'
EXPOSE 8080
CMD ["python", "-m", "loom_control_plane"]
