WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/loom-node-resource-stats ./cmd/loom-node-resource-stats
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/loom-node-resource-stats ./cmd/loom-node-resource-stats

FROM python:3.11-slim
RUN apt-get update -qq && \
    apt-get install -y --only-upgrade --no-install-recommends perl-base=5.40.1-6+deb13u1 && \
    rm -rf /var/lib/apt/lists/*
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
ENV PYTHONPATH=/app/src
WORKDIR /app
COPY deploy/execution-actuator-requirements.txt ./deploy/execution-actuator-requirements.txt
RUN pip install --no-cache-dir --requirement deploy/execution-actuator-requirements.txt
COPY src/loom/__init__.py src/loom/dockerfile_instructions.py src/loom/nebius_terminus_image.py \
