FROM python:3.11-slim
RUN apt-get update -qq && \
    apt-get install -y --only-upgrade --no-install-recommends perl-base=5.40.1-6+deb13u1 && \
    rm -rf /var/lib/apt/lists/*
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
RUN apt-get update -qq && \
    apt-get install -y --only-upgrade --no-install-recommends perl-base && \
    rm -rf /var/lib/apt/lists/*
ENV PYTHONPATH=/app/src
WORKDIR /app
COPY deploy/execution-actuator-requirements.txt ./deploy/execution-actuator-requirements.txt
RUN pip install --no-cache-dir --requirement deploy/execution-actuator-requirements.txt
COPY src/loom/__init__.py src/loom/execution_contract.py src/loom/execution_architecture.py \
    src/loom/execution_image_admission.py src/loom/execution_runtime_contract.py \
    src/loom/execution_diagnosis_store.py src/loom/execution_failure_diagnosis.py \
    src/loom/execution_requirements.py src/loom/mutable_paths.py src/loom/sandbox_identity.py src/loom/task_fixtures.py \
    src/loom/task_image_materialization.py src/loom/task_image_build_plan.py \
    src/loom/nebius_rollout_guard.py src/loom/nebius_kubernetes.py src/loom/startup_retry.py src/loom/terminal_result_semantics.py src/loom/resource_usage_store.py ./src/loom/
COPY src/loom/agent_runtime.py src/loom/request_params.py src/loom/service_execution_materialization.py \
    src/loom/verifier_runtime.py src/loom/hosted_harness.py src/loom/task_sandbox_planner.py \
    src/loom/task_bundle_registration.py src/loom/task_bundle_source.py \
    src/loom/task_bundle_source_journal.py src/loom/task_bundle_source_storage.py \
    src/loom/task_image_bundle_manifest.py src/loom/terminal_bench_normalize.py \
    src/loom/harbor_task_import.py src/loom/task_runtime_compatibility.py ./src/loom/
COPY src/loom/nebius_pool_allocation.py src/loom/nebius_pool_contract.py \
    src/loom/nebius_pool_execution_runtime.py src/loom/nebius_pool_lifecycle.py \
    src/loom/nebius_pool_native_runtime.py src/loom/nebius_pool_priority.py \
    src/loom/nebius_pool_settings.py src/loom/nebius_pool_task_image.py \
    src/loom/nebius_pool_workload.py src/loom/execution_resource_allocation.py ./src/loom/
COPY src/loom/application_image_build.py src/loom/application_session.py \
    src/loom/application_source.py src/loom/application_source_archive.py \
    src/loom/application_source_upload.py src/loom/native_image_build.py \
    src/loom/nebius_application_contract.py src/loom/nebius_environment_contract.py \
    src/loom/nebius_management_authority.py src/loom/nebius_pool_application_image.py ./src/loom/
COPY src/loom/driver/__init__.py src/loom/driver/task_image.py ./src/loom/driver/
COPY src/loom/family_run/__init__.py src/loom/family_run/spec.py ./src/loom/family_run/
COPY src/loom/trajectory/__init__.py src/loom/trajectory/storage.py ./src/loom/trajectory/
COPY src/loom/db ./src/loom/db
COPY src/loom/security ./src/loom/security
COPY src/loom/models/__init__.py src/loom/models/healthcheck.py src/loom/models/mcp.py \
    src/loom/models/networking.py src/loom/models/skill.py src/loom/models/task.py \
    src/loom/models/types.py src/loom/models/trial.py src/loom/models/resource_usage.py \
    src/loom/models/harbor.py src/loom/models/task_compatibility.py ./src/loom/models/
COPY src/loom/pipeline/__init__.py src/loom/pipeline/keys.py ./src/loom/pipeline/
COPY src/loom_control_plane/__init__.py src/loom_control_plane/execution_admission.py \
    src/loom_control_plane/execution_capacity.py src/loom_control_plane/execution_finance.py \
    src/loom_control_plane/execution_capacity_targets.py \
    src/loom_control_plane/execution_placement.py \
    src/loom_control_plane/task_image_materializations.py src/loom_control_plane/task_image_capacity.py \
    src/loom_control_plane/task_image_capacity_wait.py \
    src/loom_control_plane/metrics.py src/loom_control_plane/service_execution.py \
    src/loom_control_plane/service_execution_scheduler.py \
    src/loom_control_plane/service_execution_task_snapshot.py \
    src/loom_control_plane/execution_resource_allocation.py src/loom_control_plane/pool_execution_handoff.py \
    ./src/loom_control_plane/
COPY src/loom_execution_actuator ./src/loom_execution_actuator
COPY src/loom_execution_capacity_collector ./src/loom_execution_capacity_collector
COPY database/migrations ./database/migrations
USER 65532:65532
# Claims validate task models after imports complete. Exercise that lazy
# dependency path as well, without credentials, connections or task execution.
RUN python - <<'PY'
import loom_execution_actuator.__main__
import loom_execution_capacity_collector.__main__
import loom.task_bundle_source_journal
import loom.execution_diagnosis_store
from loom.models.task import EnvironmentConfig, TaskSidecarConfig, TaskConfig
from loom.harbor_task_import import project_harbor_task
from loom.task_runtime_compatibility import task_runtime_rejections

EnvironmentConfig(os="linux", docker_image="registry.example/task@sha256:" + "a" * 64)
fixture = TaskSidecarConfig(
    name="server", fixture=True, hostname="fixture.example",
    dockerfile="fixtures/server/Dockerfile", docker_build_context="fixtures/server",
    command=["python3", "/server.py"], ports=(23,),
    cpus=0.1, memory_mb=128, storage_mb=128,
    healthcheck={"command": "true", "interval_sec": 1, "timeout_sec": 1, "retries": 1},
)
EnvironmentConfig(
    os="linux",
    dockerfile="environment/Dockerfile", docker_build_context="environment",
    sidecars=[fixture],
)
native = TaskConfig.model_validate(project_harbor_task({
    "task": {"name": "native-image-import-check"},
    "environment": {"gpus": 1, "gpu_types": ["H100"]},
}))
assert "environment.gpu_types: exact_gpu_model_runtime_unavailable" in task_runtime_rejections(native)
PY
EXPOSE 8093
CMD ["python", "-m", "loom_execution_actuator"]
