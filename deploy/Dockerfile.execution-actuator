COPY src/loom/agent_runtime.py src/loom/request_params.py src/loom/service_execution_materialization.py \
    src/loom/prebuilt_task_images.py \
    src/loom/verifier_runtime.py src/loom/harbor_verifier_script.py src/loom/guest_compose.py src/loom/hosted_harness.py src/loom/task_sandbox_planner.py \
    src/loom/task_bundle_registration.py src/loom/task_bundle_source.py \
