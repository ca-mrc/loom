FROM python:3.12-slim
# Retry transient package-index timeouts during image builds.
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
# Pinned Harbor Terminus2 runtime for the built-in terminus-2 agent.
ARG HARBOR_COMPAT_SHA=09f5b964f8e5075f7e52fd08c9994dfc80ad5d24
WORKDIR /app
# Worker uses the Docker SDK for Python (the `docker` PyPI package
# already in pyproject.toml deps) to talk to the host daemon over the
# bind-mounted /var/run/docker.sock. No CLI binary needed in the image.
COPY pyproject.toml README.md ./
COPY src ./src
COPY packages ./packages
COPY deploy/patches/harbor-current-user-tool-probes.patch /tmp/harbor-current-user-tool-probes.patch
# git resolves the pinned Harbor source; patch applies our current-user tool probes.
# Purging them in the same layer removes Git's unused Perl runtime.
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends perl-base=5.40.1-6+deb13u1 git patch && \
    pip install --no-cache-dir -e ./packages/loom-bundle-checksum && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir -e ./packages/loom-launcher && \
    pip install --no-cache-dir -e ./packages/loom-benchmarks && \
    pip install --no-cache-dir \
      "harbor @ git+https://github.com/harbor-framework/harbor.git@${HARBOR_COMPAT_SHA}" && \
    patch --batch --forward -p1 -d "$(python -c 'import harbor; print(next(iter(harbor.__path__)))')" < /tmp/harbor-current-user-tool-probes.patch && \
    rm /tmp/harbor-current-user-tool-probes.patch && \
    apt-get purge -y --auto-remove git patch && \
    rm -rf /var/lib/apt/lists/* && \
    pip check
CMD ["python", "-m", "loom_worker"]
